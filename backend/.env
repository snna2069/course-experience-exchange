# Server Configuration
PORT=5000

# Database Configuration (Choose either DATABASE_URL or individual DB settings)
DATABASE_URL=postgresql://postgres:sneha@localhost:5432/postgres

# Alternatively, you can use these individual variables if you prefer not to use DATABASE_URL
# DB_USER=postgres
# DB_PASSWORD=sneha
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=postgres

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret

# Kafka Broker Configuration
KAFKA_BROKER=localhost:9092

# Environment (can be 'development' or 'production')
NODE_ENV=production
