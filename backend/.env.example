# Copy this file to .env and adjust values for your local environment.
# .env is gitignored and should never be committed with real secrets.

# ---- Active (MongoDB/Express) backend configuration ----

# Port the Express server listens on
PORT=5000

# MongoDB connection string used by the active backend (server.js/db.js)
MONGODB_URI=mongodb://localhost:27017/courseexperienceexchange

# Frontend origin allowed to call this API (used for CORS)
FRONTEND_URL=http://localhost:3000

# Reserved for future JWT-based authentication; not yet used by the
# active /api/auth routes.
JWT_SECRET=replace_with_a_long_random_string

# development | production
NODE_ENV=development

# ---- Legacy/inactive backend configuration (backend/index.js) ----
# Only needed if you are experimenting with the separate PostgreSQL/Kafka
# implementation, which is not part of the canonical application path.

# DATABASE_URL=postgres://user:password@localhost:5432/postgres
# KAFKA_BROKER=localhost:9092
